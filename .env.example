# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. .env는 git에 커밋하지 마세요.

DB_USERNAME=postgres
DB_PASSWORD=changeme

REDIS_PASSWORD=

# HMAC-SHA 요구사항상 최소 256비트(32바이트) 이상이어야 함 (짧으면 WeakKeyException으로 부팅 실패)
JWT_SECRET=changeme-please-replace-with-a-random-secret-of-32-bytes-or-more
FRONTEND_URL=https://example.com
# 브라우저에서 API를 호출할 수 있는 프론트 주소, 쉼표로 구분 (#154). 경로 없이 https://funzy.kr 처럼 scheme·host만.
# 설정하지 않으면 FRONTEND_URL + 프론트 개발용 http://localhost:3000, http://localhost:8000.
# 빈 값(CORS_ALLOWED_ORIGINS=)은 docker compose 밖에서 실행하면 기동 실패라 쓸 때만 주석을 푼다
# CORS_ALLOWED_ORIGINS=https://funzy.kr
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# prod 프로필은 EmailSender 빈이 있어야 부팅됨(VerificationEmailListener가 필수로 주입받음).
# false로 두면 컨테이너가 UnsatisfiedDependencyException으로 부팅 자체에 실패하니 true 유지.
# 값이 비어있어도(더미 SMTP) 부팅은 되고, 실제 메일 발송 시점에만 실패함.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 매일 새벽 4시 정리 작업(#122: 방치된 편지·오래된 알림·안 쓰는 S3 사진 삭제).
# 실제 운영 서버의 .env에서만 true로 켜세요. 로컬에서 켜면 거의 빈 로컬 DB를 기준으로
# 운영 버킷(AWS_S3_BUCKET 기본값 sdp-funzy)의 사진을 "안 쓰는 사진"으로 보고 지울 수 있습니다.
# 켜기 전 확인: AWS 키에 s3:ListBucket 권한, 버킷 버전 관리 꺼짐
CLEANUP_ENABLED=false

# 웹 푸시(#89). 키 쌍은 `npx web-push generate-vapid-keys`로 만든다. 키를 바꾸면 기존 구독이 전부 무효가 된다.
# PUSH_ENABLED=true면 두 키가 모두 있어야 기동한다. VAPID_SUBJECT는 mailto: 또는 https 주소 (설정하지 않으면 FRONTEND_URL)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:funzy@example.com
